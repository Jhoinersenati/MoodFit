---
import Layout from '../layouts/Layout.astro';
import { MoodCard } from '../components/MoodCard';
import { Onboarding } from '../components/Onboarding';
import { UserGreeting } from '../components/UserGreeting';
import { UserProfileMenu } from '../components/UserProfileMenu';

const moods = [
  // Mujeres
  { id: 'triste', name: 'Triste', icon: 'sentiment_dissatisfied', color: 'bg-blue-500', image: 'https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=600&q=80' },
  { id: 'cansado', name: 'Cansado', icon: 'bedtime', color: 'bg-orange-500', image: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?w=600&q=80' },
  { id: 'estresado', name: 'Estresado', icon: 'monitor_heart', color: 'bg-teal-500', image: 'https://images.unsplash.com/photo-1507398941214-572c25f4b1dc?w=600&q=80' },
  { id: 'alegre', name: 'Alegre', icon: 'sentiment_very_satisfied', color: 'bg-yellow-500', image: 'https://images.unsplash.com/photo-1538805060514-97d9cc17730c?w=600&q=80' },
  { id: 'emocionado', name: 'Emocionado', icon: 'auto_awesome', color: 'bg-pink-500', image: 'https://images.unsplash.com/photo-1522898467493-49726bf28798?w=600&q=80' },
  // Hombres
  { id: 'enojado', name: 'Enojado', icon: 'thunderstorm', color: 'bg-red-500', image: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=600&q=80' },
  { id: 'aburrido', name: 'Aburrido', icon: 'sentiment_neutral', color: 'bg-gray-500', image: 'https://images.unsplash.com/photo-1599058945522-28d584b6f0ff?w=600&q=80' },
  { id: 'ansioso', name: 'Ansioso', icon: 'psychology_alt', color: 'bg-indigo-500', image: 'https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=600&q=80' },
  { id: 'energico', name: 'Enérgico', icon: 'directions_run', color: 'bg-rose-500', image: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=600&q=80' },
  { id: 'inseguro', name: 'Inseguro', icon: 'lock', color: 'bg-purple-500', image: 'https://images.unsplash.com/photo-1574680096145-d05b474e2155?w=600&q=80' },
];
---

<Layout title="Bio-Entrenador IA - Smart Fitness">
  <script>
    import { supabase } from '../lib/supabase';
    
    // Verificar autenticación apenas carga la página
    supabase.auth.getSession().then(async ({ data }) => {
      if (!data.session) {
        window.location.href = '/login';
      } else {
        const { data: profile } = await supabase
          .from('perfiles')
          .select('rol')
          .eq('id', data.session.user.id)
          .single();
          
        if (profile?.rol === 'coach') {
          window.location.href = '/dashboard';
        }
      }
    });
  </script>

	<main class="min-h-screen bg-slate-900 text-slate-100 relative flex flex-col font-sans">
    {/* Imagen de Fondo Global (Bright Outdoor) */}
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <img 
        src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=2000&q=80" 
        alt="Gym Background" 
        class="w-full h-full object-cover opacity-60" 
      />
      {/* Gradiente oscuro suave para legibilidad */}
      <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <Onboarding client:only="react" />
		
    {/* Navbar */}
    <nav class="w-full px-6 py-6 flex flex-col md:flex-row justify-between items-center gap-4 relative z-10 bg-slate-900/80 backdrop-blur-md border-b border-white/10">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center shadow-lg">
          <span class="material-symbols-rounded text-white">fitness_center</span>
        </div>
        <h1 class="text-2xl font-black tracking-tight text-white">
          BIO-<span class="text-indigo-400">ENTRENADOR</span>
        </h1>
      </div>
      <div class="flex items-center gap-4">
        <a href="/coaches" class="bg-indigo-900 hover:bg-indigo-800 text-indigo-100 px-5 py-2.5 rounded-full font-bold transition-all border border-indigo-500/50 flex items-center gap-2 text-sm shadow-lg">
          <span class="material-symbols-rounded text-lg">star</span>
          Coaches Premium
        </a>
        <UserProfileMenu client:only="react" />
      </div>
    </nav>

    {/* Hero Section */}
    <div class="flex-grow flex flex-col items-center pt-16 md:pt-20 px-4 relative z-10 w-full max-w-6xl mx-auto pb-20">
      <header class="text-center mb-10 animate-in fade-in slide-in-from-bottom-8 duration-1000 w-full max-w-3xl flex flex-col items-center">
        <h2 class="text-4xl md:text-6xl font-black text-white tracking-tighter drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)] mb-4">
          Tu entrenamiento, <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-400 drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)]">adaptado a ti.</span>
        </h2>
        <p class="text-white text-lg md:text-xl font-medium leading-relaxed max-w-2xl mb-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
          Nuestro sistema adapta tu rutina de entrenamiento según tu estado físico y emocional.
        </p>

        <UserGreeting client:only="react" />
      </header>

      {/* Grid de Emociones */}
      <div class="w-full animate-in fade-in slide-in-from-bottom-12 duration-1000 delay-300 fill-mode-both">
        <div class="flex items-center gap-3 mb-8 justify-center md:justify-start">
          <span class="material-symbols-rounded text-blue-500">grid_view</span>
          <h3 class="text-xl font-bold text-slate-200">Selecciona tu estado actual para comenzar</h3>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-5">
          {moods.map((mood) => (
            <MoodCard client:load id={mood.id} name={mood.name} icon={mood.icon} color={mood.color} image={mood.image} />
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,1,0" rel="stylesheet" />
